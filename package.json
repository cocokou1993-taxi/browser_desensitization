{
  "name": "local-redaction-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/sync-dictionary.mjs && node scripts/build.mjs",
    "package": "npm run check && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "pretest": "node scripts/sync-dictionary.mjs",
    "sync-dictionary": "node scripts/sync-dictionary.mjs",
    "test": "node --test tests/redaction.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run sync-dictionary && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
